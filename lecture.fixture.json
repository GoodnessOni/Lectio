    "transcript": {
      "language": "en",
      "segments": [
        { "id": "seg_001", "startSec": 0.0, "endSec": 14.2, "text": "Today we look at Bernoulli's equation for steady, incompressible flow along a streamline." },
        { "id": "seg_002", "startSec": 14.2, "endSec": 33.5, "text": "P plus one half rho v squared plus rho g h is constant along the streamline." },
        { "id": "seg_003", "startSec": 33.5, "endSec": 58.0, "text": "Example: water flows at 2 metres per second in a pipe, the pipe narrows and speed becomes 4 metres per second." },
        { "id": "seg_004", "startSec": 58.0, "endSec": 81.4, "text": "Same height, so the pressure drop is one half times 1000 times 16 minus 4, which is 6000 pascals." },
        { "id": "seg_005", "startSec": 81.4, "endSec": 102.0, "text": "Remember, this does not hold where there is friction loss or a pump in the line." }
      ]
    },
    "notes": {
      "sections": [
        {
          "id": "note_1",
          "heading": "Bernoulli's equation",
          "kind": "definition",
          "body": "For steady, incompressible, frictionless flow along a streamline: P + 1/2 rho v^2 + rho g h = constant.",
          "sourceSegmentIds": ["seg_001", "seg_002"]
        },
        {
          "id": "note_2",
          "heading": "Worked example: narrowing pipe",
          "kind": "worked_steps",
          "body": "Pressure falls when speed rises at the same height.",
          "steps": [
            "Given v1 = 2 m/s, v2 = 4 m/s, same height, rho = 1000 kg/m^3.",
            "P1 - P2 = 1/2 x 1000 x (4^2 - 2^2).",
            "P1 - P2 = 500 x 12 = 6000 Pa."
          ],
          "sourceSegmentIds": ["seg_003", "seg_004"]
        },
        {
          "id": "note_3",
          "heading": "Limits",
          "kind": "key_point",
          "body": "Does not apply directly with friction losses or a pump in the line.",
