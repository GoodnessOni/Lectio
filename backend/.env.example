# Copy to backend/.env and fill in locally. Never commit .env or real keys.
# Existing process environment values are not overwritten when .env is loaded.

# Optional. If unset, processing jobs fail with: AI provider is not configured.
GROQ_API_KEY=

# Provisional Groq models. These can be changed without a contract change.
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Comma-separated exact origins. No wildcard.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File paths. Defaults are local to this backend folder.
# LECTIO_DATA_DIR=/absolute/path/to/data
# LECTIO_OFFLINE_READER_DIR=/absolute/path/to/offline-reader

# Demo limits (contract defaults). Integers only.
# LECTIO_MAX_RECORDINGS=3
# LECTIO_MAX_UPLOAD_BYTES=20971520
# LECTIO_MAX_DURATION_SEC=180

# Bind address is chosen at process start, not here. See README.
